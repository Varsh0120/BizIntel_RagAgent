SUPABASE_URL=REDACTED
AUTH_API_KEY=REDACTED
DATABASE_API_KEY=REDACTED
STORAGE_BUCKET=documents
GROQ_API_KEY=REDACTED
GROQ_MODEL_NAME=openai/gpt-oss-20b
GROQ_TIMEOUT_SECONDS=45
GROQ_MAX_ATTEMPTS=4
MAX_OUTPUT_TOKENS=800
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_BYTES=5242880
MAX_FILENAME_LENGTH=120
ALLOWED_EXTENSIONS=.txt,.md,.markdown,.csv,.json,.pdf,.docx,.xlsx,.xls,.pptx,.ppt,.doc,.html,.htm,.xml,.rtf

# Vector DB provider.
# Active Render path: Qdrant Cloud.
# Previous local Chroma reference kept intentionally:
# CHROMA_PATH=./chroma_vector_db
# VECTOR_DB_PROVIDER=chroma
VECTOR_DB_PROVIDER=qdrant
# TODO: Fill these with values from Qdrant Cloud.
QDRANT_CLOUD_URL=TODO_ADD_YOUR_QDRANT_CLOUD_URL
QDRANT_API_KEY=TODO_ADD_YOUR_QDRANT_API_KEY
QDRANT_COLLECTION=enterprise_knowledge
# jina-embeddings-v3 returns 1024-dimensional vectors.
QDRANT_VECTOR_SIZE=1024

# Embedding provider.
# Active Render path: Jina API.
# Previous local embedding reference kept intentionally:
# EMBEDDING_PROVIDER=local
# EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
EMBEDDING_PROVIDER=jina
# TODO: Fill this with your Jina API key.
JINA_API_KEY=TODO_ADD_YOUR_JINA_API_KEY
JINA_EMBEDDING_MODEL=jina-embeddings-v3
JINA_TIMEOUT_SECONDS=60

CHUNK_SIZE=500
CHUNK_OVERLAP=50
RETRIEVE_N=5
TOP_K=3
RERANKER_THRESHOLD=0.35
SEMANTIC_FALLBACK_THRESHOLD=0.25
KEYWORD_FALLBACK_THRESHOLD=0.5

# Reranker provider.
# Active Render path: Jina API reranker.
# Previous local reranker reference kept intentionally:
# RERANKER_PROVIDER=local
# RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2
# Use RERANKER_PROVIDER=none only if you want to skip reranking.
RERANKER_PROVIDER=jina
JINA_RERANKER_MODEL=jina-reranker-v2-base-multilingual

CONVERSATION_HISTORY_TURNS=3
MAX_HISTORY_CHARS=12000
ASK_RATE_LIMIT=20
UPLOAD_RATE_LIMIT=5
RATE_LIMIT_WINDOW_SECONDS=60
MAX_PROMPT_LENGTH=4000
